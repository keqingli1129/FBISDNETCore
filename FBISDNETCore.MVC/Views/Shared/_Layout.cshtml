<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FBISD</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FBISDNETCore.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Utility Bar -->
    <div class="utility-bar">
        <partial name="_LoginPartial" />
    </div>

    <!-- Site Header -->
    <header class="site-header">
        <div class="logo-group">
            <img src="~/images/logo.png" alt="FBISD Logo" />
            <div class="logo-text">
                <h1>FORT BEND ISD</h1>
                <span>Established 1959</span>
            </div>
        </div>
        <div class="mission-text">
            FBISD exists to inspire and equip all students to pursue futures beyond what they can imagine.
        </div>
    </header>

    <!-- Main Navigation -->
    <nav class="main-nav">
        <ul>
            <li><a class="active" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a href="#">Our District</a></li>
            <li><a href="#">Departments</a></li>
            <li><a href="#">Parents &amp; Students</a></li>
            <li><a href="#">Community</a></li>
            <li><a href="#">Staff</a></li>
            <li><a href="#">Education Foundation</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Calendar</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
        <!-- Motto Bar -->
        <div class="footer-motto">
            <span>INSPIRE</span> &bull; <span>EQUIP</span> &bull; <span>IMAGINE</span>
        </div>

        <!-- Main Footer Content -->
        <div class="footer-main">
            <div class="footer-image">
                <img src="~/images/footer-building.png" alt="FBISD Building" />
            </div>
            <div class="footer-contact">
                <div class="footer-logo-text">FBISD</div>
                <p>📍 16431 Lexington Blvd.<br />Sugar Land, TX 77479</p>
                <p>📞 (281) 634-1000</p>
            </div>
            <div class="footer-links">
                <h4>IMPORTANT LINKS</h4>
                <div class="footer-links-grid">
                    <ul>
                        <li><a href="#">Required Postings</a></li>
                        <li><a href="#">Public Notice of Grants</a></li>
                        <li><a href="#">Accessibility</a></li>
                        <li><a href="#">Site Map</a></li>
                    </ul>
                    <ul>
                        <li><a href="#">Public Information Requests</a></li>
                        <li><a href="#">Ethics Reporting</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a href="#">Terms of Use</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-social">
                <a href="#" aria-label="Twitter">🐦</a>
                <a href="#" aria-label="Facebook">📘</a>
                <a href="#" aria-label="YouTube">▶️</a>
                <a href="#" aria-label="Instagram">📷</a>
                <a href="#" aria-label="LinkedIn">💼</a>
            </div>
        </div>

        <!-- Disclaimer -->
        <div class="footer-disclaimer">
            <p>The Fort Bend Independent School District, an Equal Opportunity Educational Provider and Employer, does not discriminate on the basis of race, color, religion, gender, sex, national origin, disability and/or age, military status, genetic information, or any other basis prohibited by law in educational programs or activities that it operates or in employment decisions.</p>
        </div>

        <!-- Bottom Bar -->
        <div class="footer-bottom">
            <p>Questions or Feedback? &middot; Web Community Manager Privacy Policy (Updated)<br />Copyright &copy; 2026 Finalsite - all rights reserved.</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
