@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-avatar">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 12c2.761 0 5-2.239 5-5s-2.239-5-5-5-5 2.239-5 5 2.239 5 5 5z" stroke="#6b1a2a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M20.59 20.59A10 10 0 0 0 3.41 20.59" stroke="#6b1a2a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Sign in to your account to continue</p>

        <form id="account" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

            <label asp-for="Input.Email" class="form-label">Email</label>
            <div class="input-group mb-3">
                <span class="input-group-text bg-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3 8.5v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M21 7l-9 6-9-6" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger"></span>

            <label asp-for="Input.Password" class="form-label">Password</label>
            <div class="input-group mb-2">
                <span class="input-group-text bg-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M7 11V8a5 5 0 0 1 10 0v3" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger"></span>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
                </div>
            </div>

            <div class="d-grid mb-3">
                <button id="login-submit" type="submit" class="btn btn-maroon btn-lg">Sign In</button>
            </div>
        </form>

        <div class="divider mb-3"><span>or continue with</span></div>

        @* Placeholders until each provider is registered. To wire one up, change its button to
           type="submit" name="provider" value="<scheme name>"; this form already posts to ExternalLogin. *@
        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div class="d-grid gap-2">
                <button type="button" class="btn external-btn d-flex align-items-center" title="Skyward Login is not configured yet">
                    <span class="me-3" aria-hidden="true">🔐</span>
                    <span class="flex-grow-1 text-start">Continue with Skyward Login</span>
                </button>
                <button type="button" class="btn external-btn d-flex align-items-center" title="Google is not configured yet">
                    <span class="me-3"><svg width="20" height="20" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" /><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" /><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" /><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" /></svg></span>
                    <span class="flex-grow-1 text-start">Continue with Google</span>
                </button>
                <button type="button" class="btn external-btn d-flex align-items-center" title="EntraID is not configured yet">
                    <span class="me-3"><svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="1" y="1" width="10" height="10" fill="#F25022" /><rect x="13" y="1" width="10" height="10" fill="#7FBA00" /><rect x="1" y="13" width="10" height="10" fill="#00A4EF" /><rect x="13" y="13" width="10" height="10" fill="#FFB900" /></svg></span>
                    <span class="flex-grow-1 text-start">Continue with EntraID</span>
                </button>
            </div>
        </form>

        <div class="text-center mt-3">
            <p class="mb-1">Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up</a></p>
            <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
