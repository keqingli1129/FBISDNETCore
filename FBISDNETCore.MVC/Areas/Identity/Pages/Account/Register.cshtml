@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-avatar">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M10 12c2.761 0 5-2.239 5-5s-2.239-5-5-5-5 2.239-5 5 2.239 5 5 5z" stroke="#6b1a2a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M18.59 20.59A10 10 0 0 0 1.41 20.59" stroke="#6b1a2a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M20 8v6M17 11h6" stroke="#6b1a2a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <h1 class="auth-title">Create Account</h1>
        <p class="auth-subtitle">Sign up to get started</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

            <label asp-for="Input.Email" class="form-label">Email</label>
            <div class="input-group mb-1">
                <span class="input-group-text bg-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3 8.5v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M21 7l-9 6-9-6" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger d-block mb-2"></span>

            <label asp-for="Input.Password" class="form-label">Password</label>
            <div class="input-group mb-1">
                <span class="input-group-text bg-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M7 11V8a5 5 0 0 1 10 0v3" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger d-block mb-2"></span>

            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
            <div class="input-group mb-1">
                <span class="input-group-text bg-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M7 11V8a5 5 0 0 1 10 0v3" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M9.5 16.5l1.75 1.75L14.5 15" stroke="#6b1a2a" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm password" />
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger d-block mb-3"></span>

            <div class="d-grid mb-3">
                <button id="registerSubmit" type="submit" class="btn btn-maroon btn-lg">Sign Up</button>
            </div>
        </form>

        <div class="text-center mt-3">
            <p class="mb-1">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
